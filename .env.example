# ---------------------------------------------------------------------------
# Number masking service — example environment.
# Copy to .env and replace every placeholder. Never commit a filled .env.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
POSTGRES_USER=masking
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=masking
DATABASE_URL=postgresql+asyncpg://masking:change-me-postgres@127.0.0.1:5432/masking
REDIS_URL=redis://127.0.0.1:6379/0

# --- Asterisk ARI ----------------------------------------------------------
# ARI must never be published outside the host / internal docker network.
ARI_URL=http://127.0.0.1:8088
ARI_USER=masking
ARI_PASSWORD=change-me-ari
ARI_APP=masking
# Prototype: softphones register under their own digits.
# Production trunk: PJSIP/{number}@trunk-operator
ENDPOINT_TEMPLATE=PJSIP/{digits}

# --- REST API --------------------------------------------------------------
# Comma-separated list of accepted X-API-Key values.
API_KEYS=dev-key-change-me
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_BODY_BYTES=8192

# Run the ARI Stasis application inside the API process (single-process mode).
# Set to false to run `masking-ari` as a separate container/process.
RUN_ARI_IN_API=true

# --- Business rules --------------------------------------------------------
DEFAULT_TTL_SECONDS=86400
MAX_TTL_SECONDS=2592000
NUMBER_COOLDOWN_HOURS=24
# number = a released proxy number is quarantined for everyone (matches the spec
#          and acceptance test 12)
# party  = quarantined only for the two parties of the closed session
COOLDOWN_SCOPE=number
ORIGINATE_TIMEOUT=45
# auto = exclusive number first, shared number + DTMF PIN as fallback
# always = every session gets a PIN | never = 409 instead of a shared number
EXT_CODE_MODE=auto
EXT_CODE_LENGTH=4
EXT_CODE_MAX_PER_NUMBER=50
DTMF_DIGIT_TIMEOUT_SECONDS=5
DTMF_TOTAL_TIMEOUT_SECONDS=15
DTMF_MAX_ATTEMPTS=3

# --- Retention (background cleanup) ----------------------------------------
CALL_RETENTION_DAYS=90
CLOSED_SESSION_RETENTION_DAYS=30
CLEANUP_INTERVAL_SECONDS=3600
EXPIRY_SCAN_INTERVAL_SECONDS=30

# --- Privacy / crypto ------------------------------------------------------
# PARTY_HASH_SECRET: HMAC-SHA256 key for searchable hashes of phone numbers.
# ENCRYPTION_KEY:    AES-256-GCM key, base64(32 bytes).
# Generate both with:  make secrets
PARTY_HASH_SECRET=change-me-hash-secret-at-least-32-chars
ENCRYPTION_KEY=change-me-base64-32-bytes

# --- Webhooks (optional) ---------------------------------------------------
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=5

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Demo SIP accounts (used by asterisk config templating / make demo) -----
SIP_A_PASSWORD=change-me-sip-a-16chars
SIP_B_PASSWORD=change-me-sip-b-16chars
