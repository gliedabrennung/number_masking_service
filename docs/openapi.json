    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "Returns liveness: the process is up and serving.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Returns readiness, one flag per dependency, 503 when not ready.\n\nThe database session is opened by hand rather than injected: a dependency\nthat fails to connect would abort the request with a 500 and hide which\ncomponent is broken.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
