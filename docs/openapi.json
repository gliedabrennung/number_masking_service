  "components": {
    "schemas": {
      "CallListOut": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CallOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "title": "CallListOut",
        "description": "A page of the call journal."
      },
      "CallOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "proxy_number": {
            "type": "string",
            "title": "Proxy Number"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "answered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answered At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "duration_sec": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Sec"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "hangup_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hangup Cause"
          }
        },
        "type": "object",
        "required": [
          "id",
          "session_id",
          "direction",
          "proxy_number",
          "started_at",
          "answered_at",
          "ended_at",
          "duration_sec",
          "status",
          "hangup_cause"
        ],
        "title": "CallOut",
        "description": "One journal entry. Carries no real phone number."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthOut",
        "description": "Liveness response."
      },
      "NumberCreate": {
        "properties": {
          "e164": {
            "type": "string",
            "maxLength": 20,
            "title": "E164",
            "examples": [
              "+77011234567"
            ]
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ],
            "title": "Status",
            "default": "enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "e164"
        ],
        "title": "NumberCreate",
        "description": "Body of ``POST /numbers``."
      },
      "NumberOut": {
        "properties": {
          "e164": {
            "type": "string",
            "title": "E164"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "active_sessions": {
            "type": "integer",
            "title": "Active Sessions"
          },
          "released_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Released At"
          },
          "in_cooldown": {
            "type": "boolean",
            "title": "In Cooldown"
          }
        },
        "type": "object",
