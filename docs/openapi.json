    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Metrics",
        "description": "Returns application metrics in the Prometheus text format.\n\nAsterisk exposes its own channel and bridge metrics separately, through\n``res_prometheus`` on the ARI HTTP socket.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
